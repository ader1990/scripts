#SYSROOT="/build/riscv-usr"
#CC="riscv64-cros-linux-gnu-gcc --sysroot=${SYSROOT} -B/build/riscv-usr/usr/lib64"
#CXX="riscv64-cros-linux-gnu-g++ --sysroot=${SYSROOT} -B/build/riscv-usr/usr/lib64"

CPPFLAGS="-I/build/riscv-usr/usr/include"

CFLAGS="-O2 -pipe -march=rv64gc -mabi=lp64d --sysroot=/usr/riscv64-cros-linux-gnu"
CXXFLAGS="${CFLAGS}"

LDFLAGS="--sysroot=/usr/riscv64-cros-linux-gnu -L/usr/riscv64-cros-linux-gnu/usr/lib64 -L/usr/riscv64-cros-linux-gnu/lib64 -L/build/riscv-usr/usr/lib64 -Wl,-rpath-link,/build/riscv-usr/usr/lib64"


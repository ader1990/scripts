From 9661c67f9bbb6cbf6f84f680e305edd40930fe9a Mon Sep 17 00:00:00 2001
From: Your Name <you@example.com>
Date: Mon, 2 Nov 2026 17:23:05 +0000
Subject: [PATCH] add riscv

---
 CMakeLists.txt | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index f6beb46..1ab9ce0 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -9,7 +9,7 @@ enable_language(C)
 set(CMAKE_CXX_FLAGS_RELEASE "-O2 -DNDEBUG")
 set(CMAKE_CXX_FLAGS_RELWITHDEBINFO "-O2 -DNDEBUG -g")
 
-if (NOT (CMAKE_SYSTEM_PROCESSOR STREQUAL x86_64) AND NOT (CMAKE_SYSTEM_PROCESSOR STREQUAL aarch64) AND NOT (CMAKE_SYSTEM_PROCESSOR STREQUAL arm64))
+if (NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|aarch64|arm64|riscv64)$")
     message(FATAL_ERROR "Unknown CPU architecture ${CMAKE_SYSTEM_PROCESSOR}")
 endif ()
 

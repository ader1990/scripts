--- /dev/null
+++ b/thread/riscv64-context.h
@@ -0,0 +1,141 @@
+/*
+ * Experimental Linux RV64/LP64D backend, licensed under Apache-2.0.
+ */
+#pragma once
+#include <cstddef>
+#include <cstdint>
+
+#if !defined(__linux__) || !defined(__riscv_float_abi_double)
+#error "Photon RV64 context switching requires Linux and the LP64D ABI"
+#endif
+
+struct alignas(16) PhotonRV64Context {
+    uint64_t ra;
+    uint64_t s[12];
+    uint64_t fcsr;
+    uint64_t fs[12];
+};
+static_assert(sizeof(PhotonRV64Context) == 208, "RV64 context size mismatch");
+static_assert(offsetof(PhotonRV64Context, s) == 8, "RV64 s0 offset mismatch");
+static_assert(offsetof(PhotonRV64Context, fcsr) == 104, "RV64 fcsr offset mismatch");
+static_assert(offsetof(PhotonRV64Context, fs) == 112, "RV64 fs0 offset mismatch");
+
+extern "C" void photon_rv64_switch(void** from, void** to);
+extern "C" void photon_rv64_switch_defer(
+    void* arg, void (*defer)(void*), void** to, void** from);
+
+asm(R"(
+    .text
+    .macro photon_rv64_save
+        addi sp, sp, -208
+        sd ra, 0(sp)
+        sd s0, 8(sp)
+        sd s1, 16(sp)
+        sd s2, 24(sp)
+        sd s3, 32(sp)
+        sd s4, 40(sp)
+        sd s5, 48(sp)
+        sd s6, 56(sp)
+        sd s7, 64(sp)
+        sd s8, 72(sp)
+        sd s9, 80(sp)
+        sd s10, 88(sp)
+        sd s11, 96(sp)
+        frcsr t0
+        sd t0, 104(sp)
+        fsd fs0, 112(sp)
+        fsd fs1, 120(sp)
+        fsd fs2, 128(sp)
+        fsd fs3, 136(sp)
+        fsd fs4, 144(sp)
+        fsd fs5, 152(sp)
+        fsd fs6, 160(sp)
+        fsd fs7, 168(sp)
+        fsd fs8, 176(sp)
+        fsd fs9, 184(sp)
+        fsd fs10, 192(sp)
+        fsd fs11, 200(sp)
+    .endm
+
+    .macro photon_rv64_restore
+        ld ra, 0(sp)
+        ld s0, 8(sp)
+        ld s1, 16(sp)
+        ld s2, 24(sp)
+        ld s3, 32(sp)
+        ld s4, 40(sp)
+        ld s5, 48(sp)
+        ld s6, 56(sp)
+        ld s7, 64(sp)
+        ld s8, 72(sp)
+        ld s9, 80(sp)
+        ld s10, 88(sp)
+        ld s11, 96(sp)
+        ld t0, 104(sp)
+        fscsr t0
+        fld fs0, 112(sp)
+        fld fs1, 120(sp)
+        fld fs2, 128(sp)
+        fld fs3, 136(sp)
+        fld fs4, 144(sp)
+        fld fs5, 152(sp)
+        fld fs6, 160(sp)
+        fld fs7, 168(sp)
+        fld fs8, 176(sp)
+        fld fs9, 184(sp)
+        fld fs10, 192(sp)
+        fld fs11, 200(sp)
+        addi sp, sp, 208
+    .endm
+
+    .p2align 2
+    .globl photon_rv64_switch
+    .hidden photon_rv64_switch
+    .type photon_rv64_switch, @function
+photon_rv64_switch:
+    photon_rv64_save
+    sd sp, 0(a0)
+    ld sp, 0(a1)
+    photon_rv64_restore
+    ret
+    .size photon_rv64_switch, .-photon_rv64_switch
+
+    .p2align 2
+    .globl photon_rv64_switch_defer
+    .hidden photon_rv64_switch_defer
+    .type photon_rv64_switch_defer, @function
+photon_rv64_switch_defer:
+    photon_rv64_save
+    sd sp, 0(a3)
+    ld sp, 0(a2)
+    photon_rv64_restore
+    jr a1
+    .size photon_rv64_switch_defer, .-photon_rv64_switch_defer
+
+    .p2align 2
+    .globl _photon_switch_context_defer_die
+    .hidden _photon_switch_context_defer_die
+    .type _photon_switch_context_defer_die, @function
+_photon_switch_context_defer_die:
+    ld sp, 0(a2)
+    photon_rv64_restore
+    jr a1
+    .size _photon_switch_context_defer_die, .-_photon_switch_context_defer_die
+
+    .p2align 2
+    .globl _photon_thread_stub
+    .hidden _photon_thread_stub
+    .type _photon_thread_stub, @function
+_photon_thread_stub:
+    ld a0, 0x40(s0)
+    sd zero, 0x40(s0)
+    ld t0, 0x48(s0)
+    jalr t0
+    sd a0, 0x48(s0)
+    mv a0, s0
+    tail _photon_thread_die
+    .size _photon_thread_stub, .-_photon_thread_stub
+
+    .purgem photon_rv64_save
+    .purgem photon_rv64_restore
+)");
--- a/thread/test/CMakeLists.txt
+++ b/thread/test/CMakeLists.txt
@@ -3,3 +3,9 @@
 add_definitions(-w)

+if(CMAKE_SYSTEM_PROCESSOR STREQUAL "riscv64")
+    add_executable(test-riscv64-context test-riscv64-context.cpp)
+    target_link_libraries(test-riscv64-context PRIVATE photon_static ${testing_libs})
+    add_test(NAME test-riscv64-context COMMAND $<TARGET_FILE:test-riscv64-context>)
+    set_tests_properties(test-riscv64-context PROPERTIES TIMEOUT 120)
+endif()
 add_executable(perf_usleepdefer_semaphore perf_usleepdefer_semaphore.cpp)
--- /dev/null
+++ b/thread/test/test-riscv64-context.cpp
@@ -0,0 +1,160 @@
+/*
+ * Experimental RV64 context regression test, licensed under Apache-2.0.
+ */
+#include <photon/thread/thread.h>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <ctime>
+
+static void require(bool ok, const char* message) {
+    if (!ok) {
+        std::fprintf(stderr, "RV64 context test: %s\n", message);
+        std::abort();
+    }
+}
+
+#define RV64_REGS(OP) \
+    OP(0, 8, 112) OP(1, 16, 120) OP(2, 24, 128) OP(3, 32, 136) \
+    OP(4, 40, 144) OP(5, 48, 152) OP(6, 56, 160) OP(7, 64, 168) \
+    OP(8, 72, 176) OP(9, 80, 184) OP(10, 88, 192) OP(11, 96, 200)
+#define RV64_SEED(N, S, F) \
+    "sd s" #N ", " #S "(sp)\n" \
+    "fsd fs" #N ", " #F "(sp)\n" \
+    "li s" #N ", " #N "+100\n" \
+    "add s" #N ", s" #N ", a2\n" \
+    "li t0, " #N "+200\n" \
+    "add t0, t0, a2\n" \
+    "fmv.d.x fs" #N ", t0\n"
+#define RV64_CHECK(N, S, F) \
+    "li t0, " #N "+100\n" \
+    "add t0, t0, t2\n" \
+    "bne s" #N ", t0, 1f\n" \
+    "li t0, " #N "+200\n" \
+    "add t0, t0, t2\n" \
+    "fmv.x.d t1, fs" #N "\n" \
+    "bne t1, t0, 1f\n"
+#define RV64_RESTORE(N, S, F) \
+    "ld s" #N ", " #S "(sp)\n" \
+    "fld fs" #N ", " #F "(sp)\n"
+
+extern "C" int rv64_register_probe(void (*fn)(void*), void* arg, uint64_t seed);
+asm(
+    ".text\n.p2align 2\n.globl rv64_register_probe\n"
+    ".type rv64_register_probe, @function\nrv64_register_probe:\n"
+    "addi sp, sp, -208\nsd ra, 0(sp)\nsd a2, 104(sp)\n"
+    RV64_REGS(RV64_SEED)
+    "mv t0, a0\nmv a0, a1\njalr t0\n"
+    "ld t2, 104(sp)\n"
+    RV64_REGS(RV64_CHECK)
+    "li a0, 0\nj 2f\n1: li a0, 1\n2:\n"
+    RV64_REGS(RV64_RESTORE)
+    "ld ra, 0(sp)\naddi sp, sp, 208\nret\n"
+    ".size rv64_register_probe, .-rv64_register_probe\n");
+#undef RV64_RESTORE
+#undef RV64_CHECK
+#undef RV64_SEED
+#undef RV64_REGS
+
+struct Worker {
+    unsigned mode;
+    unsigned yields = 0;
+    unsigned callbacks = 0;
+    bool done = false;
+};
+
+static photon::rwlock shared_lock;
+static unsigned shared_value = 0;
+
+static uint32_t read_fcsr() {
+    uint32_t value;
+    asm volatile("frcsr %0" : "=r"(value));
+    return value;
+}
+
+static void deferred(void* arg) {
+    auto worker = static_cast<Worker*>(arg);
+    ++worker->callbacks;
+}
+
+static void yield_once(void* arg) {
+    auto worker = static_cast<Worker*>(arg);
+    uintptr_t sp;
+    asm volatile("mv %0, sp" : "=r"(sp));
+    require(sp % 16 == 0, "stack is not 16-byte aligned");
+    photon::thread_yield();
+    ++worker->yields;
+}
+
+static void defer_once(void* arg) {
+    require(photon::thread_usleep_defer(1, deferred, arg) == 0,
+            "deferred sleep failed");
+}
+
+static void* run_worker(void* arg) {
+    auto worker = static_cast<Worker*>(arg);
+    const uint32_t expected = (worker->mode << 5) | worker->mode;
+    asm volatile("fscsr %0" : : "r"(expected) : "memory");
+    for (unsigned i = 0; i < 2000; ++i) {
+        require(rv64_register_probe(yield_once, worker, worker->mode * 1000) == 0,
+                "callee-saved register corrupted during yield");
+        require(read_fcsr() == expected, "fcsr corrupted during yield");
+        if (i % 100 == 0) {
+            require(rv64_register_probe(defer_once, worker, worker->mode * 1000) == 0,
+                    "callee-saved register corrupted during deferred switch");
+            require(read_fcsr() == expected, "fcsr corrupted during deferred switch");
+        }
+        const bool writer = i % 2 == 0;
+        require(shared_lock.lock(writer ? photon::WLOCK : photon::RLOCK) == 0,
+                "rwlock acquisition failed");
+        const auto value = shared_value;
+        photon::thread_yield();
+        require(shared_value == value, "rwlock exclusion failed");
+        if (writer) ++shared_value;
+        require(shared_lock.unlock() == 0, "rwlock release failed");
+    }
+    worker->done = true;
+    return arg;
+}
+
+static uint64_t monotonic_us() {
+    timespec ts;
+    require(clock_gettime(CLOCK_MONOTONIC, &ts) == 0, "clock_gettime failed");
+    return uint64_t(ts.tv_sec) * 1000000 + uint64_t(ts.tv_nsec) / 1000;
+}
+
+int main() {
+    require(photon::vcpu_init() >= 0, "vcpu_init failed");
+    Worker workers[2];
+    workers[0].mode = 1;
+    workers[1].mode = 2;
+    photon::join_handle* joins[2];
+    for (unsigned i = 0; i < 2; ++i) {
+        auto thread = photon::thread_create(run_worker, &workers[i]);
+        require(thread != nullptr, "thread_create failed");
+        joins[i] = photon::thread_enable_join(thread);
+        require(joins[i] != nullptr, "thread_enable_join failed");
+    }
+    for (auto join : joins) photon::thread_join(join);
+    require(shared_value == 2000, "rwlock lost updates");
+    for (auto& worker : workers) {
+        require(worker.done && worker.yields == 2000 && worker.callbacks == 20,
+                "worker did not finish all switches");
+    }
+    for (unsigned i = 0; i < 100; ++i) {
+        Worker detached;
+        detached.mode = 1;
+        require(photon::thread_create([](void* arg) -> void* {
+            static_cast<Worker*>(arg)->done = true;
+            return nullptr;
+        }, &detached) != nullptr, "detached thread_create failed");
+        while (!detached.done) photon::thread_yield();
+        photon::thread_yield();
+    }
+    const auto before = monotonic_us();
+    require(photon::thread_usleep(20000) == 0, "timed sleep failed");
+    const auto elapsed = monotonic_us() - before;
+    require(elapsed >= 15000 && elapsed < 5000000, "timed sleep outside bounds");
+    require(photon::vcpu_fini() >= 0, "vcpu_fini failed");
+    std::puts("RV64 context tests passed");
+}

